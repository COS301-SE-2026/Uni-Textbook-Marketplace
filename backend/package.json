{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "seed": "ts-node  src/database/seeds/seed-runner.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "test:cov:auth": "jest --coverage --collectCoverageFrom=\"src/auth/**/*.ts\" --collectCoverageFrom=\"!src/auth/**/*.spec.ts\" src/auth/",
    "test:cov:listings": "jest --coverage --collectCoverageFrom=\"src/listings/listings.service.ts\" --collectCoverageFrom=\"!src/listings/**/*.spec.ts\" src/listings/listings.service.spec.ts",
    "test:auth": "jest --testPathPatterns='auth.service.spec.ts' --watch",
    "test:cov:messaging": "jest --coverage --collectCoverageFrom=\"src/messaging/**/*.ts\" --collectCoverageFrom=\"!src/messaging/**/*.module.ts\" --collectCoverageFrom=\"!src/messaging/**/*.controller.ts\" --collectCoverageFrom=\"!src/messaging/dto/**/*.ts\" test/messaging.service.spec.ts",
    "test:cov:auth-listings": "jest --coverage --collectCoverageFrom=\"src/auth/**/*.ts\" --collectCoverageFrom=\"src/listings/listings.service.ts\" --collectCoverageFrom=\"src/messaging/**/*.ts\" --collectCoverageFrom=\"!src/**/*.spec.ts\" src/auth/ src/listings/listings.service.spec.ts src/messaging/",
    "test:cov": "jest --coverage --collectCoverageFrom=\"src/auth/**/*.ts\" --collectCoverageFrom=\"src/listings/listings.service.ts\" --collectCoverageFrom=\"src/messaging/**/*.ts\" --collectCoverageFrom=\"!src/**/*.spec.ts\" src/auth/ src/listings/listings.service.spec.ts src/messaging/",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:run": "typeorm migration:run -d dist/data-source.js",
    "migration:generate": "cross-env NODE_OPTIONS=--no-experimental-strip-types typeorm-ts-node-commonjs migration:generate -d src/data-source.ts"
  },
  "dependencies": {
    "@azure/storage-blob": "12.33.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "3.1.0",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "11.4.4",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/typeorm": "11.0.1",
    "@types/nodemailer": "8.0.0",
    "axios": "1.18.0",
    "babel-jest": "^29.7.0",
    "bcrypt": "6.0.0",
    "bcryptjs": "3.0.3",
    "cheerio": "1.2.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "csv-writer": "1.6.0",
    "dotenv": "16.6.1",
    "ecdsa-sig-formatter": "1.0.11",
    "firebase-admin": "14.2.0",
    "lodash.includes": "4.3.0",
    "next": "16.2.9",
    "nodemailer": "9.0.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.20.0",
    "puppeteer": "24.43.1",
    "puppeteer-extra": "3.3.6",
    "puppeteer-extra-plugin-stealth": "2.11.2",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.12.3",
    "rxjs": "^7.8.1",
    "semver": "6.3.1",
    "swagger-ui-express": "5.0.1",
    "typeorm": "0.3.29",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "6.0.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "2.2.0",
    "@types/node": "^24.12.4",
    "@types/passport-jwt": "4.0.1",
    "@types/puppeteer": "5.4.7",
    "@types/supertest": "^7.0.0",
    "@types/uuid": "10.0.0",
    "cross-env": "10.1.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.spec.ts",
      "!main.ts",
      "!**/*.module.ts",
      "!database/entities/**/*.ts",
      "!database/migrations/**/*.ts",
      "!data-source.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
